# ---- LLM (Ollama) ----
# Where your Ollama server listens. For a GPU box on your LAN:
# http://192.168.1.50:11434
OLLAMA_URL=http://localhost:11434
MODEL_DEFAULT=qwen3:8b
# Optional failover chain (url|model, comma-separated, first = preferred).
# Overrides OLLAMA_URL/MODEL_DEFAULT when set:
#LLM_BACKENDS=http://192.168.1.50:11434|qwen3:8b,http://localhost:11434|qwen3:4b
LLM_TIMEOUT=300
LLM_CONNECT_TIMEOUT=5
# Optional: second model used when a message starts with "code:" (empty = off)
MODEL_CODER=

# ---- WhatsApp Cloud API (developers.facebook.com -> your app) ----
# WhatsApp -> API Setup:
WA_TOKEN=
WA_PHONE_ID=
# App settings -> Basic -> App secret (verifies webhook signatures):
WA_APP_SECRET=
# Any random string; enter the same one in the webhook config page:
WA_VERIFY_TOKEN=
# Your own WhatsApp number(s), E.164 without '+', comma-separated:
ALLOWED_WA_NUMBERS=

# Local development ONLY: accept unsigned webhooks (never in production)
#WA_ALLOW_UNSIGNED=true

# ---- Behaviour ----
# Words accepted as confirmation/cancellation for gated actions:
CONFIRM_WORDS=yes,y,confirm,ok
CANCEL_WORDS=no,n,cancel
# Free text appended to the system prompt (language, timezone, preferences):
OWNER_NOTES=

# ---- Built-in tools ----
SEARXNG_URL=http://searxng:8080
